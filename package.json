{
  "name": "supertokens-plugin-user-banning",
  "version": "0.0.1",
  "description": "User Banning Plugin for SuperTokens",
  "main": "index.js",
  "scripts": {
    "build": "npm run build:backend && npm run build:frontend",
    "pretty": "npx pretty-quick .",
    "build-pretty": "npm run build && npm run pretty && npm run pretty",
    "pretty-check": "npx pretty-quick --check .",
    "build:backend": "cd lib/user-banning/backend && rm -rf dist && npx tsc -p tsconfig.json",
    "build:frontend": "cd lib/user-banning/frontend && rm -rf build && vite build"
  },
  "keywords": [
    "user-banning",
    "plugin",
    "supertokens"
  ],
  "exports": {
    "./backend": {
      "types": "./lib/user-banning/backend/dist/index.d.ts",
      "default": "./lib/user-banning/backend/dist/index.js"
    },
    "./backend/index": {
      "types": "./lib/user-banning/backend/dist/index.d.ts",
      "default": "./lib/user-banning/backend/dist/index.js"
    },
    "./backend/index.js": {
      "types": "./lib/user-banning/backend/dist/index.d.ts",
      "default": "./lib/user-banning/backend/dist/index.js"
    },
    "./frontend": {
      "types": "./lib/user-banning/frontend/build/index.d.ts",
      "import": "./lib/user-banning/frontend/build/index.mjs",
      "require": "./lib/user-banning/frontend/build/index.cjs"
    }
  },
  "license": "Apache-2.0",
  "dependencies": {
    "supertokens-auth-react": "github:supertokens/supertokens-auth-react#feat/plugin/base",
    "supertokens-node": "github:supertokens/supertokens-node#feat/plugin/base"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.1",
    "@types/react": "^17.0.20",
    "@vitejs/plugin-react": "^4.5.2",
    "mocha": "^10.2.0",
    "postcss": "^8.4.19",
    "postcss-import": "^15.0.0",
    "postcss-preset-env": "^7.8.3",
    "prettier": "2.0.5",
    "pretty-quick": "^3.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sinon": "^14.0.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.4"
  },
  "browser": {
    "fs": false
  }
}

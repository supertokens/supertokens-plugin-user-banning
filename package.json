{
  "name": "supertokens-plugin-user-banning",
  "version": "0.0.1",
  "description": "User Banning Plugin for SuperTokens",
  "main": "index.js",
  "scripts": {
    "build": "npm run build:backend && npm run build:frontend",
    "pretty": "npx pretty-quick .",
    "build-pretty": "npm run build && npm run pretty && npm run pretty",
    "pretty-check": "npx pretty-quick --check .",
    "build:backend": "cd lib/user-banning/backend && rm -rf dist && npx tsc -p tsconfig.json",
    "build:frontend": "cd lib/user-banning/frontend && rm -rf build && npx rollup -c rollup.config.mjs"
  },
  "keywords": ["user-banning", "plugin", "supertokens"],
  "exports": {
    "./backend": {
      "types": "./lib/user-banning/backend/index.d.ts",
      "default": "./lib/user-banning/backend/index.js"
    },
    "./backend/index": {
      "types": "./lib/user-banning/backend/index.d.ts",
      "default": "./lib/user-banning/backend/index.js"
    },
    "./backend/index.js": {
      "types": "./lib/user-banning/backend/index.d.ts",
      "default": "./lib/user-banning/backend/index.js"
    },
    "./frontend": {
      "types": "./lib/user-banning/frontend/index.d.ts",
      "default": "./lib/user-banning/frontend/index.js"
    },
    "./frontend/index": {
      "types": "./lib/user-banning/frontend/index.d.ts",
      "default": "./lib/user-banning/frontend/index.js"
    },
    "./frontend/index.js": {
      "types": "./lib/user-banning/frontend/index.d.ts",
      "default": "./lib/user-banning/frontend/index.js"
    }
  },
  "license": "Apache-2.0",
  "dependencies": {
    "supertokens-auth-react": "github:supertokens/supertokens-auth-react#feat/plugin/base",
    "supertokens-node": "github:supertokens/supertokens-node#feat/plugin/base"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^23.0.3",
    "@rollup/plugin-json": "^5.0.0",
    "@rollup/plugin-multi-entry": "^6.0.0",
    "@rollup/plugin-node-resolve": "^15.0.1",
    "@rollup/pluginutils": "^5.0.2",
    "@types/node": "14.11.10",
    "@types/react": "^17.0.20",
    "mocha": "^10.2.0",
    "postcss": "^8.4.19",
    "postcss-import": "^15.0.0",
    "postcss-preset-env": "^7.8.3",
    "prettier": "2.0.5",
    "pretty-quick": "^3.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rollup": "^3.1.0",
    "rollup-plugin-import-css": "^3.1.0",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-typescript2": "^0.34.1",
    "rollup-plugin-visualizer": "^5.8.3",
    "rollup-pluginutils": "^2.8.2",
    "sinon": "^14.0.0",
    "typescript": "^5.7.3"
  },
  "browser": {
    "fs": false
  }
}

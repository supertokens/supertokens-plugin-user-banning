{
  "compilerOptions": {
    "target": "ES2017",
    "strictNullChecks": true,
    "declaration": true,
    "module": "commonJS",
    "outDir": "dist",
    "moduleResolution": "Node",
    "noImplicitAny": true,
    "sourceMap": false,
    "noImplicitThis": false,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "lib": ["ES2017"],
    "esModuleInterop": true,
    "useUnknownInCatchVariables": false
  },
  "include": ["src/**/*"],
  "exclude": ["dist"],
  "compileOnSave": true
}
